<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="System.Formats.Cbor" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Going.Plaid" />
    <PackageReference Include="MaxMind.GeoIP2" />
    <PackageReference Include="FirebaseAdmin" />
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Sentry" />
    <PackageReference Include="Mscc.GenerativeAI" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="Qdrant.Client" />
    <PackageReference Include="Stripe.net" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Resend" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="WebAuthn.Net" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Explicit pin: override vulnerable transitive System.Security.Cryptography.Xml 9.0.0 with safe version (10.0.10 via Directory.Packages.props) -->
    <PackageReference Include="System.Security.Cryptography.Xml" PrivateAssets="all" />
    <!-- Override vulnerable transitive System.Security.Cryptography.Pkcs (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) with the patched version in Directory.Packages.props -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuoyAI.Core\BuoyAI.Core.csproj" />
  </ItemGroup>

  <!-- SQL-first migrations: forward (*.up.sql) scripts are embedded so DbUp applies
       them on startup. Paired *.down.sql files are committed for manual, reviewed
       rollback (NOT embedded / not auto-run). See Migrations/Sql/README.md (#533). -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\Sql\*.up.sql" />
  </ItemGroup>

  <!-- Help content: published blog/help articles (checked-in copy synced from
       marketing/src/content/blog via scripts/sync-help.sh) are embedded so
       HelpContentService can read + index them at runtime (search_help /
       get_help_article MCP tools). -->
  <ItemGroup>
    <EmbeddedResource Include="HelpContent\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BuoyAI.UnitTests" />
    <InternalsVisibleTo Include="BuoyAI.AiBench" />
  </ItemGroup>

</Project>
