{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=BuoyAI;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "BuoyAI",
    "Audience": "BuoyAI-Users",
    "ExpiryInMinutes": 60
  },
  "Google": {
    "ClientId": "YOUR_BACKEND_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "ClientSecret": "YOUR_GOOGLE_OAUTH_CLIENT_SECRET",
    "AllowedAudiences": [
      "YOUR_WEB_AND_MOBILE_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
    ]
  },
  "AppleAuth": {
    "Issuer": "https://appleid.apple.com",
    "JwksUri": "https://appleid.apple.com/auth/keys",
    "_comment_clientids": "Allowed token audiences (aud). Add the native iOS bundle ID AND — for web 'Sign in with Apple' — the Services ID, whose value is the aud of every web-issued token. Prod supplies these as env vars: AppleAuth__ClientIds__0=com.buoyai.buoyAi, AppleAuth__ClientIds__1=<your Services ID>. Defaults to the bundle ID when unset.",
    "ClientIds": [
      "com.yourcompany.yourapp",
      "com.yourcompany.web"
    ],
    "_comment": "Below are only needed for account-deletion revocation + server-to-server notifications. Prod supplies them as deploy env vars (AppleAuth__TeamId etc.); PrivateKey is the .p8 contents (newlines may be '\\n'-escaped). All optional — the revocation/exchange no-op gracefully when absent.",
    "TeamId": "YOURTEAMID",
    "KeyId": "YOURKEYID",
    "ClientId": "com.yourcompany.yourapp",
    "PrivateKey": "",
    "PrivateKeyPath": ""
  },
  "Plaid": {
    "Environment": "sandbox",
    "ClientId": "YOUR_PLAID_CLIENT_ID",
    "SecretKey": "YOUR_PLAID_SECRET_KEY",
    "WebhookUrl": "http://localhost:5000/api/plaid/webhook/receive",
    "ClientName": "Buoy Money Development",
    "AndroidPackageName": "com.buoyai.buoy_ai",
    "CountryCodes": ["US"],
    "Products": ["transactions"],
    "RateLimits": {
      "BalanceRequestsPerDay": 5,
      "RefreshRequestsPerDay": 3,
      "EnableRateLimiting": true
    }
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Models": {
      "Standard": {
        "Primary": "gemini-3.5-flash-lite",
        "Fallback": "gemini-2.5-flash"
      },
      "Premium": {
        "Primary": "gemini-3.8-flash",
        "Secondary": "gemini-3.7-flash"
      },
      "Admin": {
        "Primary": "gemini-3.8-flash",
        "Secondary": "gemini-3.7-flash"
      }
    },
    "RateLimiting": {
      "_Comment": "Read by AIUsageTracker. Hourly caps (Standard 10, Premium 50) are in code; per-minute caps are the 'ai' policy in Program.cs.",
      "StandardUserRequestsPerDay": 50,
      "PremiumUserRequestsPerDay": 200
    }
  },
  "Founding": {
    "SpotLimit": 150
  },
  "Encryption": {
    "Key": "YOUR_32_CHARACTER_ENCRYPTION_KEY"
  },
  "Mcp": {
    "SigningKey": ""
  },
  "Resend": {
    "ApiKey": "YOUR_RESEND_API_KEY",
    "FromEmail": "noreply@yourdomain.com",
    "FromName": "Buoy Money Development",
    "ReplyToEmail": "support@buoy-ai.com"
  },
  "Firebase": {
    "_comment": "Push notifications (#190). Provide the Firebase Admin SDK service-account credential (Firebase console > Project settings > Service accounts) either inline as CredentialsJson (how deploys inject it, from the FIREBASE_ADMIN_CREDENTIALS environment secret) or as a file path in CredentialsPath (local dev). Leave both empty to disable push entirely — every push path no-ops. GOOGLE_APPLICATION_CREDENTIALS also works.",
    "CredentialsJson": "",
    "CredentialsPath": ""
  },
  "WebAuthn": {
    "RelyingPartyId": "localhost",
    "RelyingPartyName": "Buoy Money Development",
    "Origin": "http://localhost:3000"
  },
  "App": {
    "BaseUrl": "http://localhost:3000"
  },
  "Subscription": {
    "TrialPeriodDays": 14,
    "ExtendedTrialPeriodDays": 30
  },
  "Stripe": {
    "PublishableKey": "pk_test_YOUR_STRIPE_PUBLISHABLE_KEY",
    "SecretKey": "sk_test_YOUR_STRIPE_SECRET_KEY",
    "WebhookSecret": "whsec_YOUR_STRIPE_WEBHOOK_SECRET",
    "Products": {
      "Standard": {
        "Monthly": "price_YOUR_STANDARD_MONTHLY_PRICE_ID",
        "Yearly": "price_YOUR_STANDARD_YEARLY_PRICE_ID"
      },
      "Premium": {
        "Monthly": "price_YOUR_PREMIUM_MONTHLY_PRICE_ID",
        "Yearly": "price_YOUR_PREMIUM_YEARLY_PRICE_ID"
      }
    }
  },
  "Reservations": {
    "Enabled": false,
    "AmountCents": 100,
    "Currency": "usd",
    "ProductName": "Buoy Money founding member reservation",
    "SuccessUrl": "http://localhost:4321/founding/thanks",
    "CancelUrl": "http://localhost:4321/founding"
  },
  "Admin": {
    "Emails": [ "operator@example.com" ]
  }
}
