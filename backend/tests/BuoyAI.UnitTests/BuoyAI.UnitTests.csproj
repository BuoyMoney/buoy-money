<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Mscc.GenerativeAI" />
    <PackageReference Include="FluentAssertions" />
    <!-- Override vulnerable transitive System.Security.Cryptography.Xml 9.0.0 (10.0.10 via Directory.Packages.props) -->
    <PackageReference Include="System.Security.Cryptography.Xml" PrivateAssets="all" />
    <!-- Override vulnerable transitive System.Security.Cryptography.Pkcs (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) with the patched version in Directory.Packages.props -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" PrivateAssets="all" />
  </ItemGroup>

  <!-- The wire contract with the Cloud billing service, pinned as golden JSON (see CloudBillingContractTests). -->
  <ItemGroup>
    <None Include="Contracts\cloud-billing\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Contracts\cloud-billing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuoyAI.API\BuoyAI.API.csproj" />
    <ProjectReference Include="..\..\src\BuoyAI.Core\BuoyAI.Core.csproj" />
    <ProjectReference Include="..\..\src\BuoyAI.Infrastructure\BuoyAI.Infrastructure.csproj" />
    <ProjectReference Include="..\..\tools\BuoyAI.AiBench\BuoyAI.AiBench.csproj" />
  </ItemGroup>

</Project>
