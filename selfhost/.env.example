# Copy to .env (next to compose.yaml). Every line is optional: the defaults give you
# http://localhost:8080 on the machine itself.

# Which release to run. "latest" follows the newest; pin a number (for example 1.6.0) to upgrade on purpose.
# BUOY_VERSION=latest

# The address people type into the browser. Passkeys are tied to the host name, so set these
# BEFORE anyone registers a passkey; changing them later invalidates every passkey.
# Use https:// and your real name when something (Caddy, Tailscale) provides HTTPS.
# BUOY_HOST=buoy.example.ts.net
# BUOY_ORIGIN=https://buoy.example.ts.net

# The account with this email is the admin. Set it before you register that account.
# BUOY_ADMIN_EMAIL=you@example.com

# Port, and which network interface to listen on. 127.0.0.1 keeps the app off your LAN when a
# proxy on this machine (Caddy, Tailscale) is the front door.
# BUOY_PORT=8080
# BUOY_BIND=0.0.0.0

# AI is OFF until you pick a provider. Everything below is optional; docs/self_host/ai.md has the details.
# Ollama on this machine (free, private; categorization works well from about 7B parameters):
# BUOY_AI_PROVIDER=ollama
# BUOY_AI_MODEL=qwen2.5:7b
# BUOY_AI_BASE_URL=http://host.docker.internal:11434/v1
# On Linux, Ollama must listen on all addresses (OLLAMA_HOST=0.0.0.0) or the container is refused. See docs/self_host/ai.md.
# A cloud service (costs money, sends your transaction text to them): openai, openrouter, gemini-compat, or custom
# BUOY_AI_PROVIDER=openrouter
# BUOY_AI_MODEL=your/model-name
# BUOY_AI_API_KEY=sk-...
# AI bought from BuoyAI Cloud (a monthly allowance, no provider account needed). Pair this server first, then:
# BUOY_AI_PROVIDER=buoy-cloud
# BUOY_AI_CLOUD_URL=https://...
# BUOY_AI_CLOUD_CREDENTIAL=...
# Models that think before answering (Qwen3, DeepSeek-R1) are far faster with thinking off:
# BUOY_AI_REASONING_EFFORT=none
# Optional embedding model, for similar-transaction and help search (Ollama: nomic-embed-text):
# BUOY_AI_EMBEDDING_MODEL=nomic-embed-text
# Slow local model? Raise the per-call timeout (default 120). Also available:
# BUOY_AI_TIMEOUT_SECONDS=300
# BUOY_AI_EMBEDDING_DIMENSIONS, BUOY_AI_TEMPERATURE, BUOY_AI_PRICE_INPUT_PER_MILLION,
# BUOY_AI_PRICE_OUTPUT_PER_MILLION, BUOY_AI_MODEL_CATEGORIZATION, BUOY_AI_MODEL_INSIGHTS, BUOY_AI_MODEL_SUBSCRIPTIONS

# Outgoing email through any SMTP server (your mail provider, a relay, Gmail with an app password).
# Leave BUOY_SMTP_HOST empty to send no email. Security is starttls (port 587), tls (port 465) or none.
# BUOY_SMTP_HOST=smtp.example.com
# BUOY_SMTP_PORT=587
# BUOY_SMTP_SECURITY=starttls
# BUOY_SMTP_USERNAME=you@example.com
# BUOY_SMTP_PASSWORD=
# BUOY_SMTP_FROM=you@example.com

# BuoyAI Cloud: pair this server with your Cloud account, and optionally use the managed bank feed (a paid plan).
# The address alone allows pairing; the feed also needs BUOY_CLOUD_BANK_FEED=true. See docs/self_host/bridge.md.
# BUOY_CLOUD_BRIDGE_URL=https://cloud.buoymoney.com
# BUOY_CLOUD_BANK_FEED=false

# Phone notifications through the BuoyAI push relay (web address given with the relay service).
# BUOY_PUSH_RELAY_URL=

# Tools for AI assistants: lets Open WebUI (or another MCP client) read your budgets and transactions
# at <BUOY_ORIGIN>/mcp with an access token you make in the app (Settings, Connected apps). Read-only for money.
# BUOY_MCP_ENABLED=true

# Single sign-on with your own OpenID Connect provider, for example Pocket ID (passkeys only).
# At the provider, make a client named Buoy Money with callback URL <BUOY_ORIGIN>/api/auth/oidc/callback.
# See docs/self_host/sign_in_email_push.md, "Single sign-on".
# BUOY_OIDC_ENABLED=true
# BUOY_OIDC_AUTHORITY=https://id.example.ts.net
# BUOY_OIDC_CLIENT_ID=
# BUOY_OIDC_CLIENT_SECRET=
# BUOY_OIDC_DISPLAY_NAME=Pocket ID
# Give anyone who signs in an account (still bound by the sign-up rules: open sign-up or an invite).
# Off: only existing accounts, the admin email and invite codes.
# BUOY_OIDC_AUTO_REGISTER=false
# Hide the password form and refuse password sign-in. Set back to false to get passwords back.
# BUOY_OIDC_DISABLE_PASSWORD_LOGIN=false
# Count the provider sign-in as the second step and skip the app's own MFA (for a passkey provider).
# BUOY_OIDC_SKIP_APP_MFA=false
# Accept an email the provider does not mark as verified. Leave off unless you trust every account there.
# BUOY_OIDC_TRUST_UNVERIFIED_EMAIL=false
