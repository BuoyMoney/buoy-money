{
  "_comment": "Baseline for the Buoy Money self-host image (copied to /app/appsettings.json). Secrets are NOT here: the init service writes them to /secrets. Override anything with an environment variable in compose.yaml (a double underscore stands for a colon, for example WebAuthn__Origin).",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "BuoyAI",
    "Audience": "BuoyAI-Users",
    "ExpiryInMinutes": 60
  },
  "WebAuthn": {
    "RelyingPartyId": "localhost",
    "RelyingPartyName": "Buoy Money",
    "Origin": "http://localhost:8080",
    "UserVerification": "preferred"
  },
  "App": {
    "BaseUrl": "http://localhost:8080"
  },
  "Admin": {
    "Emails": []
  },
  "Mcp": {
    "Enabled": false
  },
  "Ai": {
    "RequireConfirmationToken": true
  },
  "VectorStore": {
    "Provider": "pgvector"
  },
  "Database": {
    "MaxPoolSize": 10
  },
  "Migrations": {
    "KeepBackups": 5
  }
}
