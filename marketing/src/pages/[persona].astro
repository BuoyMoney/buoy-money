---
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderMarkdown } from '../lib/markdown';
import { PERSONAS } from '../data/seo';
import { SITE } from '../consts';
import StoreBadges from '../components/StoreBadges.astro';

export function getStaticPaths() {
  return PERSONAS.map((p) => ({ params: { persona: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const url = `${SITE.url}/${p.slug}`;
const body = renderMarkdown(p.bodyMarkdown);

const jsonLd = [
  {
    '@type': 'Article',
    headline: p.title,
    description: p.metaDescription,
    mainEntityOfPage: url,
    // Named human author (see Seo.astro's Person node) — the E-E-A-T signal that carries
    // weight in YMYL finance. Organization stays as publisher.
    author: { '@id': `${SITE.url}/#founder` },
    publisher: { '@id': `${SITE.url}/#org` },
    publisher: { '@id': `${SITE.url}/#org` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: p.title, item: url },
    ],
  },
];
---

<BaseLayout title={p.title} description={p.metaDescription} path={`/${p.slug}`} ogType="article" jsonLd={jsonLd}>
  <header class="p-hero">
    <div class="container">
      <p class="kicker">{p.heroKicker}</p>
      <h1>{p.heroTitle}</h1>
      <p class="answer-first">{p.answerFirst}</p>
    </div>
  </header>

  <section class="section" style="padding-top:clamp(36px,5vw,60px)">
    <div class="container">
      <div class="prose" set:html={body} />
      <aside class="p-cta card">
        <h2>Ready to try it?</h2>
        <p>Start free, no credit card, read-only bank access via Plaid, cancel anytime.</p>
        <div class="cta-row">
          <a href={SITE.appRegister} class="btn btn-primary">Start your free trial</a>
          <a href="/count-up-budgeting" class="btn btn-ghost">How count-up works</a>
        </div>
        <div class="p-badges">
          <StoreBadges align="center" />
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .p-hero {
    background: linear-gradient(180deg, var(--sky-top), var(--surface));
    padding: clamp(48px, 8vw, 88px) 0 clamp(24px, 4vw, 40px);
  }
  .p-hero .container {
    max-width: 820px;
  }
  .p-hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    margin-bottom: 22px;
  }
  .answer-first {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink);
    background: var(--surface-tint);
    border-left: 4px solid var(--green);
    border-radius: 0 14px 14px 0;
    padding: 20px 24px;
    margin: 0;
  }
  .prose {
    margin-bottom: 44px;
  }
  .p-cta {
    max-width: 760px;
    margin: 0 auto;
    padding: 34px 36px;
    text-align: center;
  }
  .p-cta h2 {
    font-size: 1.6rem;
  }
  .p-cta p {
    color: var(--ink-soft);
    margin: 10px 0 22px;
  }
  .cta-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .p-badges {
    margin-top: 18px;
    display: flex;
    justify-content: center;
  }
</style>
