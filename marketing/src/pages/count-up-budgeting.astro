---
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderMarkdown } from '../lib/markdown';
import { PILLAR } from '../data/seo';
import { SITE } from '../consts';

const title = PILLAR.metaTitle.replace(/\s*\|.*$/, '');
const url = `${SITE.url}/count-up-budgeting`;
const body = renderMarkdown(PILLAR.bodyMarkdown);

const jsonLd = [
  {
    '@type': 'Article',
    headline: title,
    description: PILLAR.metaDescription,
    mainEntityOfPage: url,
    // Named human author (see Seo.astro's Person node) — the E-E-A-T signal that carries
    // weight in YMYL finance. Organization stays as publisher.
    author: { '@id': `${SITE.url}/#founder` },
    publisher: { '@id': `${SITE.url}/#org` },
    publisher: { '@id': `${SITE.url}/#org` },
    about: 'Count-up budgeting',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Count-up budgeting', item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: PILLAR.faq.map((it) => ({
      '@type': 'Question',
      name: it.q,
      acceptedAnswer: { '@type': 'Answer', text: it.a },
    })),
  },
];
---

<BaseLayout title={title} description={PILLAR.metaDescription} path="/count-up-budgeting" ogType="article" jsonLd={jsonLd}>
  <article>
    <header class="guide-hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Count-up budgeting</span>
        </nav>
        <p class="kicker">THE GUIDE</p>
        <h1>{title}</h1>
        <!-- Answer-first block (GEO: extractable summary for AI engines) -->
        <p class="answer-first">{PILLAR.answerFirst}</p>
      </div>
    </header>

    <div class="container">
      <div class="prose guide-body" set:html={body} />

      <section class="guide-faq" aria-label="Frequently asked questions">
        <h2>Frequently asked questions</h2>
        <ul class="faq-list">
          {
            PILLAR.faq.map((item, i) => (
              <li>
                <details open={i === 0}>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              </li>
            ))
          }
        </ul>
      </section>

      <aside class="guide-cta card">
        <h2>See count-up budgeting in action</h2>
        <p>Buoy is built entirely around it, link a bank, set a category, and watch it count up.</p>
        <div class="cta-row">
          <a href={SITE.appRegister} class="btn btn-primary">Start your free trial</a>
          <a href="/calculator" class="btn btn-ghost">Try the allowance calculator</a>
        </div>
        <p class="related">
          Related: <a href="/mint-alternatives">Best Mint alternatives</a> ·
          <a href="/pricing">Pricing</a> ·
          <a href="/blog/why-your-budget-should-count-up">Why budgets should count up</a>
        </p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .guide-hero {
    background: linear-gradient(180deg, var(--sky-top), var(--surface));
    padding: clamp(48px, 8vw, 88px) 0 clamp(28px, 4vw, 44px);
  }
  .guide-hero .container {
    max-width: 820px;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin-bottom: 18px;
  }
  .crumbs a:hover {
    color: var(--blue);
  }
  .guide-hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin-bottom: 24px;
  }
  .answer-first {
    font-size: 1.18rem;
    line-height: 1.55;
    color: var(--ink);
    background: var(--surface-tint);
    border-left: 4px solid var(--green);
    border-radius: 0 14px 14px 0;
    padding: 20px 24px;
    margin: 0;
  }
  .guide-body {
    margin: 44px auto;
  }
  .guide-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.95rem;
  }
  .guide-body :global(th),
  .guide-body :global(td) {
    border: 1px solid var(--line);
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
  }
  .guide-body :global(th) {
    background: var(--surface-tint);
    color: var(--ink);
    font-weight: 700;
  }
  .guide-faq {
    max-width: 760px;
    margin: 0 auto;
  }
  .guide-faq h2 {
    font-size: 1.8rem;
    margin-bottom: 20px;
  }
  .faq-list {
    list-style: none;
    margin: 0 0 48px;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .faq-list details {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 6px 20px;
  }
  .faq-list summary {
    cursor: pointer;
    font-weight: 700;
    padding: 14px 0;
  }
  .faq-list details p {
    margin: 0 0 16px;
    color: var(--ink-soft);
  }
  .guide-cta {
    max-width: 760px;
    margin: 0 auto 20px;
    padding: 34px 36px;
    text-align: center;
  }
  .guide-cta h2 {
    font-size: 1.6rem;
  }
  .guide-cta p {
    color: var(--ink-soft);
    margin: 10px 0 22px;
  }
  .cta-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .related {
    margin-top: 22px !important;
    font-size: 0.92rem;
  }
  .related a {
    color: var(--blue);
    font-weight: 600;
  }
</style>
