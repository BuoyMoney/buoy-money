---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { BLOG_INTROS } from '../../data/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = `${SITE.url}/blog/${post.id}`;

// Answer-first TL;DR + related internal links (GEO) from the SEO content engine.
const intro = BLOG_INTROS.find((b) => b.slug === post.id);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = [
  {
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    // A named human, not a faceless team byline. Personal finance is the strictest YMYL
    // category, and identifiable authorship is the E-E-A-T signal Google weights hardest
    // there. Resolves to the Person node Seo.astro emits site-wide.
    author: { '@id': `${SITE.url}/#founder` },
    publisher: { '@id': `${SITE.url}/#org` },
    publisher: { '@id': `${SITE.url}/#org` },
    mainEntityOfPage: url,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}`}
  ogType="article"
  image={`/og/${post.id}.png`}
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="container" style="max-width:760px">
      <a href="/blog" class="back">← All posts</a>
      <p class="kicker" style="margin-top:24px">
        {fmt(post.data.pubDate)} · {post.data.author}
      </p>
      <h1 class="post-h1">{post.data.title}</h1>

      {intro?.tldr && (
        <p class="tldr"><strong>TL;DR:</strong> {intro.tldr}</p>
      )}

      <div class="prose post-body">
        <Content />
      </div>

      {intro?.links?.length ? (
        <nav class="related" aria-label="Related reading">
          <h2>Keep reading</h2>
          <ul>
            {intro.links.map((l) => (
              <li><a href={l.href}>{l.text}</a></li>
            ))}
          </ul>
        </nav>
      ) : null}
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    /* Its own line: inline, it shared one with the date's inline-flex kicker, and the
       kicker's green rule ran into "All posts". */
    display: block;
    width: fit-content;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .back:hover {
    color: var(--blue);
  }
  .post-h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    margin: 8px 0 24px;
  }
  .tldr {
    background: var(--surface-tint);
    border-left: 4px solid var(--green);
    border-radius: 0 14px 14px 0;
    padding: 16px 20px;
    margin: 0 0 32px;
    color: var(--ink);
    line-height: 1.55;
  }
  .tldr strong {
    color: var(--green-text);
  }
  .post-body {
    margin: 0;
  }
  .related {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .related h2 {
    font-size: 1.2rem;
    margin-bottom: 12px;
  }
  .related ul {
    margin: 0;
    padding-left: 20px;
  }
  .related a {
    color: var(--blue);
    font-weight: 600;
  }
</style>
