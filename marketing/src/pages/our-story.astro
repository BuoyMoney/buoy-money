---
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderMarkdown } from '../lib/markdown';
import { STORY } from '../data/story';
import { SITE, FOUNDER } from '../consts';

const title = STORY.title.replace(/\s*·\s*BuoyAI\s*$/, '').replace(/^My Story\s*·\s*/, '');
const url = `${SITE.url}/our-story`;
const body = renderMarkdown(STORY.bodyMarkdown);

const founderId = `${SITE.url}/#founder`;
const jsonLd = [
  // The Person node itself now lives in Seo.astro's base graph so it is emitted on every
  // page under this same @id. Duplicating it here would put two nodes with one @id in the
  // same @graph; this page just references it.
  {
    '@type': 'AboutPage',
    name: STORY.title,
    description: STORY.metaDescription,
    url,
    publisher: { '@id': `${SITE.url}/#org` },
    author: { '@id': founderId },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'My story', item: url },
    ],
  },
];
---

<BaseLayout title={title} description={STORY.metaDescription} path="/our-story" ogType="article" jsonLd={jsonLd}>
  <header class="story-hero">
    <div class="container">
      <p class="kicker">{STORY.heroKicker}</p>
      <h1>{STORY.heroTitle}</h1>
      <p class="answer-first">{STORY.answerFirst}</p>
    </div>
  </header>

  <section class="section" style="padding-top:clamp(36px,5vw,60px)">
    <div class="container">
      <div class="prose story-body" set:html={body} />

      <section class="founder card" aria-label="From the founder">
        <img
          src={FOUNDER.photo}
          alt={`${FOUNDER.name}, founder of Buoy Money`}
          width="120"
          height="120"
          class="founder-photo"
          loading="lazy"
          decoding="async"
        />
        <div class="founder-text">
          <p class="founder-eyebrow">From the founder</p>
          {FOUNDER.bio.map((p) => <p>{p}</p>)}
          <p class="founder-sign">
            — {FOUNDER.name}, {FOUNDER.title} ·
            <a href={FOUNDER.linkedin} rel="noopener" target="_blank">LinkedIn</a>
          </p>
        </div>
      </section>

      <aside class="story-cta card">
        <h2>Come build it with me</h2>
        <p>Early on features. Serious on safety.<br />Start free, no card, read-only bank access via Plaid.</p>
        <div class="cta-row">
          <a href={SITE.appRegister} class="btn btn-primary">Start your free trial</a>
          <a href="/security" class="btn btn-ghost">How I handle your data</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .story-hero {
    background: linear-gradient(180deg, var(--sky-top), var(--surface));
    padding: clamp(48px, 8vw, 88px) 0 clamp(24px, 4vw, 40px);
  }
  .story-hero .container {
    max-width: 820px;
  }
  .story-hero h1 {
    font-size: clamp(2rem, 4.6vw, 3rem);
    margin-bottom: 22px;
  }
  .answer-first {
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--ink);
    background: var(--surface-tint);
    border-left: 4px solid var(--green);
    border-radius: 0 14px 14px 0;
    padding: 20px 24px;
    margin: 0;
  }
  .story-body {
    margin-bottom: 44px;
  }
  .founder {
    max-width: 820px;
    margin: 0 auto 32px;
    padding: 34px 36px;
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 28px;
    align-items: start;
  }
  .founder-photo {
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow-md);
  }
  .founder-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    margin: 0 0 14px;
  }
  .founder-text p {
    color: var(--ink-soft);
    margin: 0 0 14px;
    line-height: 1.6;
  }
  .founder-sign {
    color: var(--ink) !important;
    font-weight: 600;
    margin-top: 18px !important;
  }
  .founder-sign a {
    color: var(--blue);
    margin-left: 6px;
  }
  @media (max-width: 600px) {
    .founder {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }
  .story-cta {
    max-width: 760px;
    margin: 0 auto;
    padding: 34px 36px;
    text-align: center;
  }
  .story-cta h2 {
    font-size: 1.6rem;
  }
  .story-cta p {
    color: var(--ink-soft);
    margin: 10px 0 22px;
  }
  .cta-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
