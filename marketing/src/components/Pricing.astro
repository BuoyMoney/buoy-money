---
import { SITE, PRICING } from '../consts';

interface Props {
  showHeading?: boolean;
}
const { showHeading = true } = Astro.props;

// Precompute the annual economics so the markup stays declarative.
const plans = PRICING.plans.map((p) => {
  const annualIfMonthly = p.monthly * 12;
  const save = annualIfMonthly - p.annual;
  const pct = Math.round((save / annualIfMonthly) * 100);
  const perMonth = (p.annual / 12).toFixed(2).replace(/\.00$/, '');
  return { ...p, save, pct, perMonth };
});
---

<section class="section pricing" id="pricing">
  <div class="container">
    {
      showHeading && (
        <div class="section-head" style="text-align:center; margin-inline:auto">
          <p class="kicker" style="justify-content:center">
            {PRICING.kicker}
          </p>
          <h2>{PRICING.title}</h2>
          <p class="lead" style="margin:16px auto 0">
            {PRICING.subtitle}
          </p>
        </div>
      )
    }

    <!-- CSS-only billing toggle (no JS → CSP-safe). Annual is the default. -->
    <div class="billing" role="group" aria-label="Billing period">
      <input class="sr-only" type="radio" name="billing" id="bill-annual" checked />
      <label for="bill-annual">Annual</label>
      <input class="sr-only" type="radio" name="billing" id="bill-monthly" />
      <label for="bill-monthly">Monthly</label>
    </div>

    <div class="plans">
      {
        plans.map((plan) => (
          <div class:list={['card', 'plan', { featured: plan.featured }]}>
            {plan.featured && <span class="badge">Most popular</span>}
            <h3 class="plan-name">{plan.name}</h3>

            <div class="price">
              <div class="price-annual">
                <p class="amount-row">
                  <span class="amount">${plan.perMonth}</span>
                  <span class="cadence">/mo</span>
                </p>
                <p class="sub">
                  <span class="permo">Billed yearly</span>
                  <span class="save">Save ${plan.save} ({plan.pct}%)</span>
                </p>
              </div>
              <div class="price-monthly">
                <p class="amount-row">
                  <span class="amount">${plan.monthly}</span>
                  <span class="cadence">/mo</span>
                </p>
                <p class="sub">
                  <span class="permo">Billed monthly</span>
                </p>
              </div>
            </div>

            <ul class="plan-features">
              {plan.features.map((f) => (
                <li>
                  <svg class="check" viewBox="0 0 20 20" aria-hidden="true">
                    <circle cx="10" cy="10" r="10" fill="currentColor" opacity="0.14" />
                    <path
                      d="M6 10.5l2.6 2.6L14.5 7"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            <a
              href={`${SITE.appRegister}?plan=${plan.name.toLowerCase()}`}
              class:list={['btn', plan.featured ? 'btn-primary' : 'btn-ghost', 'plan-cta']}
            >
              Start free trial
            </a>
          </div>
        ))
      }
    </div>
    <p class="pricing-foot">Every plan starts with a free trial. Cancel anytime, no lock-in.<br />You're the customer, not the product: I earn only from your subscription. No ads, no commissions for pushing products, and I never sell your data.</p>
  </div>
</section>

<style>
  /* ---- billing toggle ---- */
  .billing {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px;
    margin: 0 auto 40px;
    background: var(--surface-tint);
    border: 1px solid var(--line);
    border-radius: 999px;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }
  .billing label {
    cursor: pointer;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--ink-soft);
    padding: 9px 20px;
    border-radius: 999px;
    transition: background 0.16s ease, color 0.16s ease;
  }
  .billing input:checked + label {
    background: #fff;
    color: var(--blue);
    box-shadow: var(--shadow-sm);
  }
  .billing input:focus-visible + label {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
  /* default = annual; swap when Monthly is selected (CSS :has) */
  .price-monthly {
    display: none;
  }
  .pricing:has(#bill-monthly:checked) .price-annual {
    display: none;
  }
  .pricing:has(#bill-monthly:checked) .price-monthly {
    display: block;
  }

  /* ---- plans ---- */
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 820px;
    margin: 0 auto;
  }
  .plan {
    padding: 38px 34px;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .plan.featured {
    border-color: var(--blue);
    box-shadow: var(--shadow-lg);
    padding-top: 48px; /* reserve room so the badge never collides with the name */
  }
  .badge {
    position: absolute;
    top: 20px;
    right: 22px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--blue);
    padding: 5px 11px;
    border-radius: 999px;
  }
  .plan-name {
    font-size: 1.35rem;
  }
  .price {
    margin: 12px 0 24px;
    min-height: 86px;
  }
  .amount-row {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .amount {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
  }
  .featured .amount {
    color: var(--blue);
  }
  .cadence {
    color: var(--ink-faint);
    font-weight: 600;
  }
  .sub {
    margin: 10px 0 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .permo {
    color: var(--ink-soft);
  }
  .save {
    color: var(--green-deep);
    background: rgba(30, 180, 66, 0.12);
    padding: 3px 9px;
    border-radius: 999px;
  }
  .plan-features {
    list-style: none;
    margin: 0 0 30px;
    padding: 0;
    display: grid;
    gap: 14px;
    flex: 1;
  }
  .plan-features li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .check {
    width: 22px;
    height: 22px;
    color: var(--green);
    flex-shrink: 0;
  }
  .plan-cta {
    width: 100%;
  }
  .pricing-foot {
    text-align: center;
    color: var(--ink-faint);
    font-size: 0.95rem;
    margin: 34px auto 0;
  }
  @media (max-width: 720px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
